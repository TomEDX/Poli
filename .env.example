# Local Supabase database, started by `pnpm dev`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Supabase Auth, used for the editors' magic link. These are the default
# local values, the same on every machine.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Supabase secret key, read on the server only: it writes the party logos to Storage
# (ADR 0009) and enables the local test editor sign-in. Required on Vercel for develop and
# prod. Locally, `pnpm dev` writes it to .env.development.local; never put it here, GitHub
# push protection rejects it.
# SUPABASE_SECRET_KEY=
